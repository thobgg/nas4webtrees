package="nas4webtrees"
displayname="nas4webtrees"
displayname_ger="nas4webtrees"
version="__VERSION__"
description="Online family tree: the original webtrees with SQLite, ready to use. Includes api4webtrees for the wtAnd, wtWin and wtTux apps and a nightly GEDCOM backup. Runs as a container via Container Manager. Community package, not an official part of webtrees."
description_ger="Stammbaum im Browser: das originale webtrees mit SQLite, sofort einsatzbereit. Mit api4webtrees für die Apps wtAnd, wtWin und wtTux und nächtlicher GEDCOM-Sicherung. Läuft als Container über den Container Manager. Gemeinschaftspaket, kein offizieller Teil von webtrees."
maintainer="Thomas Bugge"
maintainer_url="https://bgg-home.de"
arch="noarch"
os_min_ver="7.2-64570"
install_dep_packages="ContainerManager"
startable="yes"
ctl_stop="yes"
ctl_uninstall="yes"
precheckstartstop="yes"
adminprotocol="http"
adminport="__LAN_PORT__"
adminurl="/"
checkport="no"
dsmuidir="ui"
dsmappname="SYNO.SDS.nas4webtrees.Application"
thirdparty="yes"
silent_install="no"
silent_upgrade="no"
silent_uninstall="no"
extractsize="__EXTRACTSIZE__"
