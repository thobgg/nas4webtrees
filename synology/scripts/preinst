#!/bin/sh
# Vor Installation und Update (auch beim Update läuft das preinst der neuen Fassung): Eingaben aus
# dem Assistenten prüfen. Ein Fehler hier bricht ab, bevor irgendetwas verändert ist.
. "$(dirname "$0")/common"
log "preinst"
check_port_and_share
[ "${SYNOPKG_PKG_STATUS}" = "INSTALL" ] && check_admin_account
exit 0
