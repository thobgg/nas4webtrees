#!/bin/sh
# Nach dem Auspacken: Assistenten-Werte merken, Port in Menüeinträge und Firewall-Dienst, bei der
# Erstinstallation die Einrichtungsdaten für den Container. Image und Container übernimmt der Worker.
. "$(dirname "$0")/common"
log "postinst (Version ${SYNOPKG_PKGVER})"
save_wizard
apply_ports "$(wiz_get wizard_port)"
if [ "${SYNOPKG_PKG_STATUS}" = "INSTALL" ]; then
    write_setup
    log "Einrichtungsdaten geschrieben; der Container liest sie beim ersten Start und löscht das Passwort"
fi
exit 0
