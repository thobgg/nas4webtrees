#!/bin/sh
. "$(dirname "$0")/common"
if [ "${SYNOPKG_PKG_STATUS}" = "UPGRADE" ]; then
    log "postuninst (Update) — Programm und Daten unter ${DOCKER_DIR} bleiben"
else
    log "postuninst — Container, Image und ${DOCKER_DIR} entfernt der Worker; die Sicherung unter /<Freigabe>/${BACKUP_SUBDIR} bleibt"
fi
exit 0
